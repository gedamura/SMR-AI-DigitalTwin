# OpenMC nuclear data library -- large, shared infrastructure, not this project's work product
openmc_data/

# OpenMC statepoint files -- large binary MC output, fully regenerable by
# rerunning run_sweep.py / run_simulation.py. Not the dataset itself.
*.h5

# OpenMC's per-run generated XML config -- deterministically regenerated by
# build_materials.py / build_geometry.py / build_settings.py from source,
# not hand-authored, and gets overwritten on every run.
materials.xml
geometry.xml
settings.xml

# Python cache
__pycache__/
.pytest_cache/
*.pyc

# Do NOT ignore:
#   smr_neutronics_dataset.csv      -- the real validated Week 8 dataset
#   smr_digital_twin_model.pkl      -- the trained Week 9 surrogate model
#   smr_digital_twin_model_metadata.json
#   pipeline_failures.log           -- small, documents sweep fault tolerance
#   surrogate_accuracy.png, sweep_sanity_plot.png, log_vs_tree_comparison.png
# These are the actual deliverables/evidence this project produced.
